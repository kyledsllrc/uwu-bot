# DISCORD_BOT_TOKEN: Discord bot token from Discord Developer Portal.
# Required for fetching real-time bot status, ping, guild counts, and bot user details.
DISCORD_BOT_TOKEN="your_discord_bot_token"

# FIREBASE_CREDENTIALS: Raw JSON string or service account credentials for Firebase Realtime Database.
# Required for live user wallets, leaderboards, crypto market, and economy settings.
FIREBASE_CREDENTIALS="{\"type\":\"service_account\",\"project_id\":\"...\"}"

# FIREBASE_DATABASE_URL: URL of your Firebase Realtime Database instance.
FIREBASE_DATABASE_URL="https://uwu-bot-4cff1-default-rtdb.asia-southeast1.firebasedatabase.app"

# GEMINI_API_KEY: Google Gemini Developer API key for server-side requests.
# Configure this in your host's secret manager; do not commit a real key.
# A Gemini app subscription may not include Gemini Developer API access or quota.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: API model ID to try first for the uwu rant command.
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APIFY_API_TOKEN: Apify API token for Instagram and Facebook profile scraping.
# Supports multi-account rotation and failover (comma-separated or numbered up to 5+ accounts):
APIFY_API_TOKEN_1="your_apify_token_1"
APIFY_API_TOKEN_2="your_apify_token_2"
APIFY_API_TOKEN_3="your_apify_token_3"
APIFY_API_TOKEN_4="your_apify_token_4"
APIFY_API_TOKEN_5="your_apify_token_5"

